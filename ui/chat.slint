import { Theme } from "theme.slint";
import { MessageItem, MsgState } from "types.slint";
import { Avatar, Badge, Icon, Icons, IconButton, Pill, ScrollBar, Spinner, TypingDots } from "widgets.slint";

component MessageRow inherits Rectangle {
    in property <MessageItem> m;
    // В группах у входящих сообщений есть имя автора и аватар.
    in property <bool> group;
    callback retry();
    callback copy();

    // Новое сообщение сначала занимает нулевую высоту, затем разворачивается;
    // удаляемое так же сворачивается.
    property <bool> shown: !m.fresh;
    property <float> reveal: shown && !m.removing ? 1 : 0;
    animate reveal {
        duration: 220ms;
        easing: ease-out;
    }

    property <length> side: 14px;
    property <length> gutter: group && !m.outgoing ? 42px : 0px;
    property <length> max-bubble: max(140px, min(540px, self.width - 2 * side - gutter - 52px));
    property <length> top-gap: m.first || m.service ? 8px : 2px;
    property <length> header-h: m.date-header != "" ? 42px : 0px;
    property <length> body-h: m.service ? 26px : bubble.height;

    height: (header-h + top-gap + body-h) * reveal;
    opacity: reveal;

    Timer {
        interval: 20ms;
        running: !root.shown;
        triggered => {
            root.shown = true;
        }
    }

    if root.m.date-header != "": Pill {
        y: 10px;
        text: root.m.date-header;
    }
    if root.m.service: Pill {
        y: root.header-h + root.top-gap;
        text: root.m.text;
    }

    bubble := Rectangle {
        property <length> pad: 11px;
        property <length> max-text: root.max-bubble - 2 * pad;
        property <bool> show-name: root.group && !root.m.outgoing && root.m.first && root.m.sender != "";
        property <bool> has-text: root.m.text != "";
        property <bool> has-media: root.m.media != "";
        property <length> name-h: show-name ? 20px : 0px;
        property <length> media-h: has-media ? 21px : 0px;
        property <length> media-w: has-media ? min(media.preferred-width, max-text) : 0px;
        property <length> text-w: has-text ? min(body.preferred-width, max-text) : 0px;
        property <length> text-h: has-text ? body.preferred-height : 0px;
        // Время встаёт в последнюю строку, если рядом с ней хватает места.
        property <length> last-w: has-text ? text-w : media-w;
        property <bool> inline: last-w + 10px + meta.preferred-width <= max-text;
        property <length> inner-w: max(show-name ? min(name.preferred-width, max-text) : 0px, media-w, text-w, inline ? last-w + 10px + meta.preferred-width : meta.preferred-width);
        property <length> inner-h: name-h + media-h + text-h + (inline ? 0px : 16px);
        property <color> meta-color: root.m.outgoing ? Theme.bubble-out-meta : Theme.text-dim;

        visible: !root.m.service;
        x: root.m.outgoing ? root.width - root.side - self.width : root.side + root.gutter;
        y: root.header-h + root.top-gap;
        width: inner-w + 2 * pad;
        height: inner-h + 14px;
        background: root.m.outgoing ? Theme.bubble-out : Theme.bubble-in;
        border-top-left-radius: !root.m.outgoing && !root.m.first ? 6px : 16px;
        border-bottom-left-radius: root.m.outgoing ? 16px : root.m.last ? 4px : 6px;
        border-top-right-radius: root.m.outgoing && !root.m.first ? 6px : 16px;
        border-bottom-right-radius: !root.m.outgoing ? 16px : root.m.last ? 4px : 6px;
        opacity: root.m.state == MsgState.pending || root.m.state == MsgState.failed ? 0.72 : 1;
        animate background { duration: Theme.normal; }
        animate opacity { duration: Theme.normal; }

        TouchArea {
            pointer-event(event) => {
                if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                    root.copy();
                }
            }
        }

        name := Text {
            x: parent.pad;
            y: 7px;
            width: min(self.preferred-width, parent.max-text);
            height: 18px;
            visible: parent.show-name;
            text: root.m.sender;
            color: Theme.avatars[mod(root.m.sender-color, 7)];
            font-size: 13px;
            font-weight: 600;
            overflow: elide;
        }

        media := Text {
            x: parent.pad;
            y: 7px + parent.name-h;
            width: parent.media-w;
            height: 19px;
            visible: parent.has-media;
            text: root.m.media;
            color: root.m.outgoing ? bubble.meta-color.brighter(0.25) : Theme.accent;
            font-size: 13.5px;
            font-weight: 500;
            overflow: elide;
        }

        body := Text {
            x: parent.pad;
            y: 7px + parent.name-h + parent.media-h;
            width: parent.text-w;
            height: parent.text-h;
            visible: parent.has-text;
            text: root.m.text;
            color: Theme.text;
            font-size: 14px;
            wrap: word-wrap;
        }

        meta := HorizontalLayout {
            x: parent.width - parent.pad - self.width + 3px;
            y: parent.height - 7px - 14px;
            width: self.preferred-width;
            height: 15px;
            spacing: 3px;
            if root.m.edited: Text {
                text: "изм.";
                color: bubble.meta-color;
                font-size: 11px;
                vertical-alignment: center;
            }
            Text {
                text: root.m.time;
                color: bubble.meta-color;
                font-size: 11px;
                vertical-alignment: center;
            }

            if root.m.outgoing: VerticalLayout {
                alignment: center;
                Icon {
                    shape: root.m.state == MsgState.read ? Icons.checks : root.m.state == MsgState.sent ? Icons.check : root.m.state == MsgState.failed ? Icons.error : Icons.clock;
                    color: root.m.state == MsgState.read ? Theme.read-mark : root.m.state == MsgState.failed ? Theme.danger : bubble.meta-color;
                    size: 14px;
                }
            }
        }
    }

    if root.group && !root.m.outgoing && root.m.last && !root.m.service: Avatar {
        x: root.side;
        y: bubble.y + bubble.height - self.height;
        size: 34px;
        initials: root.m.sender-initials;
        color-index: root.m.sender-color;
    }
    if root.m.state == MsgState.failed: IconButton {
        x: bubble.x - 36px;
        y: bubble.y + (bubble.height - self.height) / 2;
        size: 30px;
        icon-size: 18px;
        shape: Icons.error;
        tint: Theme.danger;
        clicked => {
            root.retry();
        }
    }
}

// Лента сообщений, привязанная к нижнему краю: положение отсчитывается от
// конца переписки, поэтому подгрузка старых сообщений сверху его не сдвигает.
component MessageList inherits Rectangle {
    in property <[MessageItem]> messages;
    in property <bool> group;
    // Rust взводит перед добавлением сообщения, когда лента отмотана вверх.
    in-out property <bool> keep-position;
    out property <bool> at-bottom: target < 2px;
    out property <length> distance: target;
    callback need-older();
    callback retry(int);
    callback copy(string);

    property <length> target;
    property <length> pos;
    property <bool> smooth: true;
    property <bool> scrolling;
    property <length> content-h: content.height;
    property <length> last-h;
    property <length> max-scroll: max(0px, content-h - self.height);
    animate pos {
        duration: root.smooth ? 170ms : 0ms;
        easing: ease-out;
    }

    function move(to: length, smooth: bool) {
        root.smooth = smooth;
        root.target = clamp(to, 0px, root.max-scroll);
        root.pos = root.target;
    }

    function check-top() {
        if root.max-scroll - root.target < 700px {
            root.need-older();
        }
    }

    public function jump-to-bottom() {
        root.move(0px, false);
    }

    public function scroll-to-bottom() {
        root.move(0px, true);
    }

    changed content-h => {
        if root.keep-position {
            if root.target > 0px {
                root.move(root.target + root.content-h - root.last-h, false);
            }
            root.keep-position = false;
        }
        root.last-h = root.content-h;
        root.check-top();
    }
    changed max-scroll => {
        if root.target > root.max-scroll {
            root.move(root.max-scroll, false);
        }
    }
    changed target => {
        root.check-top();
    }

    clip: true;

    TouchArea {
        scroll-event(event) => {
            root.move(root.target + event.delta-y, true);
            root.scrolling = true;
            idle.restart();
            return accept;
        }
        content := VerticalLayout {
            y: root.height - self.height + min(root.pos, root.max-scroll);
            height: self.preferred-height;
            padding-top: 6px;
            padding-bottom: 8px;
            for message in root.messages: MessageRow {
                m: message;
                group: root.group;
                retry => {
                    root.retry(message.id);
                }
                copy => {
                    root.copy(message.text);
                }
            }
        }
    }

    ScrollBar {
        x: parent.width - self.width;
        height: parent.height;
        content-size: root.content-h;
        view-size: root.height;
        offset: root.max-scroll - min(root.pos, root.max-scroll);
        active: root.scrolling;
        dragged(offset) => {
            root.move(root.max-scroll - offset, false);
        }
    }

    idle := Timer {
        interval: 1200ms;
        running: false;
        triggered => {
            root.scrolling = false;
            self.stop();
        }
    }
}

component Composer inherits Rectangle {
    in-out property <string> text <=> input.text;
    out property <bool> has-focus: input.has-focus;
    callback send(string);
    callback edited();
    property <length> field-h: clamp(input.preferred-height, 22px, 132px);
    property <float> ready: input.text != "" ? 1 : 0;
    animate ready {
        duration: 180ms;
        easing: ease-out-back;
    }

    public function focus-input() {
        input.focus();
    }

    function submit() {
        if input.text != "" {
            root.send(input.text);
            input.text = "";
        }
    }

    height: field-h + 30px;
    background: Theme.header;
    animate background { duration: Theme.normal; }
    animate height {
        duration: 110ms;
        easing: ease-out;
    }

    Rectangle {
        x: 14px;
        y: 8px;
        width: parent.width - 14px - 62px;
        height: parent.height - 16px;
        border-radius: min(20px, self.height / 2);
        background: Theme.field;
        animate background { duration: Theme.normal; }

        Text {
            x: 16px;
            width: parent.width - 32px;
            text: "Сообщение";
            color: Theme.text-dim;
            font-size: 14px;
            vertical-alignment: center;
            visible: input.text == "";
        }

        scroll := Flickable {
            x: 16px;
            y: 7px;
            width: parent.width - 32px;
            height: parent.height - 14px;
            content-height: max(self.height, input.preferred-height);
            input := TextInput {
                width: scroll.width;
                height: scroll.content-height;
                single-line: false;
                wrap: word-wrap;
                color: Theme.text;
                font-size: 14px;
                selection-background-color: Theme.primary;
                selection-foreground-color: white;
                key-pressed(event) => {
                    if event.text == Key.Return && !event.modifiers.shift && !event.modifiers.control {
                        root.submit();
                        return accept;
                    }
                    return reject;
                }
                edited => {
                    root.edited();
                }
                cursor-position-changed(cursor) => {
                    if cursor.y + scroll.content-y < 0px {
                        scroll.content-y = -cursor.y;
                    } else if cursor.y + 20px + scroll.content-y > scroll.height {
                        scroll.content-y = scroll.height - cursor.y - 20px;
                    }
                }
            }
        }
    }

    // Кнопка отправки вырастает, когда есть что отправлять.
    Rectangle {
        x: parent.width - 33px - self.width / 2;
        y: parent.height - 29px - self.height / 2;
        width: 42px * root.ready;
        height: 42px * root.ready;
        border-radius: self.width / 2;
        background: send-touch.pressed ? Theme.primary.darker(0.2) : send-touch.has-hover ? Theme.primary.brighter(0.12) : Theme.primary;
        visible: root.ready > 0.05;
        animate background { duration: Theme.fast; }
        Icon {
            shape: Icons.send;
            color: white;
            solid: true;
            size: 20px * root.ready;
        }

        send-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.submit();
            }
        }
    }
}

export component ChatPane inherits Rectangle {
    // Содержимое показано; в узком окне остаётся видимым, пока панель уезжает.
    in property <bool> open;
    // Чат действительно открыт.
    in property <bool> active;
    in property <bool> narrow;
    in property <string> title;
    in property <string> subtitle;
    in property <string> initials;
    in property <int> color-index;
    in property <bool> saved;
    in property <bool> typing;
    in property <bool> group;
    in property <bool> can-write: true;
    in property <bool> loading;
    in property <[MessageItem]> messages;
    in property <int> new-below;
    in-out property <bool> keep-position <=> list.keep-position;
    in-out property <string> draft <=> composer.text;
    out property <bool> at-bottom: list.at-bottom;
    // Чат действительно читают: окно активно и лента докручена до конца.
    out property <bool> viewing: active && list.at-bottom && (composer.has-focus || reader.has-focus);
    callback send(string);
    callback edited();
    callback need-older();
    callback back();
    callback retry(int);
    callback copy(string);

    public function focus-input() {
        if root.can-write {
            composer.focus-input();
        } else {
            reader.focus();
        }
    }

    public function jump-to-bottom() {
        list.jump-to-bottom();
    }

    public function scroll-to-bottom() {
        list.scroll-to-bottom();
    }

    background: Theme.chat;
    animate background { duration: Theme.normal; }

    // В каналах без права писать фокус держит эта область: по нему видно, активно ли окно.
    reader := FocusScope { }

    list := MessageList {
        y: 56px;
        height: parent.height - 56px - footer.height;
        visible: root.open;
        messages: root.messages;
        group: root.group;
        need-older => {
            root.need-older();
        }
        retry(id) => {
            root.retry(id);
        }
        copy(text) => {
            root.copy(text);
        }
    }

    if root.open && root.loading && root.messages.length == 0: Spinner {
        y: 56px + (list.height - self.height) / 2;
        size: 34px;
    }
    if root.open && !root.loading && root.messages.length == 0: Pill {
        y: 56px + (list.height - self.height) / 2;
        text: "Здесь пока нет сообщений";
    }
    if !root.open: Pill {
        text: "Выберите чат, чтобы начать общение";
    }

    // Кнопка «в конец» выезжает, когда лента отмотана вверх.
    Rectangle {
        property <bool> show: root.open && list.distance > 260px;
        x: parent.width - 60px;
        y: list.y + list.height - (show ? 56px : 34px);
        width: 42px;
        height: 42px;
        border-radius: 21px;
        background: jump-touch.has-hover ? Theme.hover : Theme.card;
        border-width: 1px;
        border-color: Theme.divider;
        opacity: show ? 1 : 0;
        visible: self.opacity > 0.01;
        animate y {
            duration: Theme.normal;
            easing: ease-out;
        }
        animate opacity { duration: Theme.normal; }
        animate background { duration: Theme.fast; }
        Icon {
            shape: Icons.down;
            size: 22px;
        }

        jump-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                list.scroll-to-bottom();
            }
        }

        if root.new-below > 0: Badge {
            x: parent.width - self.width + 4px;
            y: -8px;
            count: root.new-below;
        }
    }

    header := Rectangle {
        y: 0px;
        height: 56px;
        background: Theme.header;
        visible: root.open;
        animate background { duration: Theme.normal; }
        property <length> lead: root.narrow ? 50px : 16px;
        if root.narrow: IconButton {
            x: 6px;
            shape: Icons.back;
            clicked => {
                root.back();
            }
        }
        Avatar {
            x: parent.lead;
            size: 40px;
            initials: root.initials;
            color-index: root.color-index;
            saved: root.saved;
        }

        VerticalLayout {
            x: parent.lead + 52px;
            width: parent.width - self.x - 16px;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: 15px;
                font-weight: 600;
                overflow: elide;
            }

            HorizontalLayout {
                alignment: start;
                spacing: 6px;
                height: 17px;
                Text {
                    text: root.subtitle;
                    color: root.typing ? Theme.accent : Theme.text-dim;
                    font-size: 13px;
                    overflow: elide;
                    vertical-alignment: center;
                }

                if root.typing: VerticalLayout {
                    alignment: center;
                    TypingDots { }
                }
            }
        }

        Rectangle {
            y: parent.height - 1px;
            height: 1px;
            background: Theme.divider;
        }
    }

    footer := Rectangle {
        y: parent.height - self.height;
        height: !root.open ? 0px : root.can-write ? composer.height : 48px;
        composer := Composer {
            y: 0px;
            visible: root.open && root.can-write;
            send(text) => {
                root.send(text);
            }
            edited => {
                root.edited();
            }
        }

        if root.open && !root.can-write: Rectangle {
            background: Theme.header;
            Text {
                text: "Писать в этот чат нельзя";
                color: Theme.text-dim;
                font-size: 14px;
            }
        }
    }
}
